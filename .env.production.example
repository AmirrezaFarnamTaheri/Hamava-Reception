# Copy using scripts/generate_env.py, then set your actual host and approved
# processors. This example never contains usable production secrets.
ENVIRONMENT=production
DEMO_MODE=false
POSTGRES_DB=hamava
POSTGRES_USER=hamava
POSTGRES_PASSWORD=GENERATE_ONCE
DATABASE_URL=postgresql+psycopg://hamava:GENERATE_ONCE@db:5432/hamava
JWT_SECRET=GENERATE_ONCE
ENCRYPTION_KEY=GENERATE_ONCE_AND_BACK_UP_SEPARATELY
ENCRYPTION_PREVIOUS_KEYS=
LOOKUP_HASH_KEY=GENERATE_INDEPENDENT_AND_KEEP_STABLE
MEDIA_API_TOKEN=GENERATE_ONCE
METRICS_TOKEN=GENERATE_ONCE
CORS_ORIGINS=https://reception.example.invalid
PUBLIC_BASE_URL=https://reception.example.invalid
PUBLIC_HOST=reception.example.invalid
RUN_WORKER=false
ACCESS_TOKEN_MINUTES=60
SHUTDOWN_GRACE_SECONDS=20
PROVIDER_HEALTH_TIMEOUT_SECONDS=5
PROVIDER_HEALTH_STALE_SECONDS=120
PROVIDER_OPERATION_TIMEOUT_SECONDS=12
TOOL_TIMEOUT_MS=3000
API_DEPRECATIONS_JSON=[]
MAX_CONCURRENT_CALLS_PER_TENANT=20
MAX_MEDIA_CONNECTIONS=8
AUDIOSOCKET_ALLOWED_CIDRS=127.0.0.0/8,::1/128
MEDIA_DID_TENANTS_JSON={}
HUMAN_TRANSFER_TARGETS=
TELEPHONY_PROCESSOR_REGION=not_configured
SPEECH_PROCESSOR_APPROVED=false
SPEECH_GATEWAY_URL=http://speech:8090
SPEECH_GATEWAY_TOKEN=GENERATE_ONCE
SPEECH_PROCESSING_LOCATION=not_configured
SPEECH_PROCESSOR_REGION=not_configured
SPEECH_MODEL_RIGHTS_REVIEWED=false
SPEECH_ASR_VERSION=not_recorded
SPEECH_VOICE_VERSION=not_recorded
SPEECH_MODELS_DIR=./models
WHISPER_MODEL_PATH=/models/whisper
PIPER_MODEL_PATH=/models/fa_IR-amir-medium.onnx
APPROVED_PROVIDER_HOSTS=speech
ALLOW_LOCAL_HTTP_PROVIDERS=false
SPEECH_FALLBACK_APPROVED=false
SPEECH_FALLBACK_URL=
SPEECH_FALLBACK_TOKEN=
SPEECH_FALLBACK_REGION=not_configured
SPEECH_FALLBACK_MODEL_VERSION=not_recorded
SPEECH_MAX_CONCURRENCY=2
SPEECH_MAX_QUEUE=8
LOCAL_COMPUTE_TOMAN_PER_HOUR=
LOCAL_COMPUTE_RATE_EVIDENCE_REFERENCE=
SMS_PROVIDER_APPROVED=false
SMS_PROCESSOR_REGION=not_configured
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=
NOTIFICATION_WEBHOOK_SECRET=
SMS_INBOUND_TENANTS_JSON={}
SMS_INBOUND_WEBHOOK_SECRET=
PAYMENT_PROVIDER_APPROVED=false
PAYMENT_PROCESSOR_REGION=not_configured
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
PAYMENT_TENANT_MERCHANTS_JSON={}
PAYMENT_MERCHANTS_JSON={}
LIVEKIT_APPROVED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CALENDAR_PARTNER_APPROVED=false
CALENDAR_PARTNER_URL=
CALENDAR_TENANT_CREDENTIALS_JSON={}
CALENDAR_WEBHOOK_SECRET=
CALENDAR_PROCESSOR_REGION=not_configured
DIGEST_PROCESSOR_APPROVED=false
DIGEST_GATEWAY_URL=
DIGEST_GATEWAY_TOKEN=
DIGEST_PROCESSOR_REGION=not_configured
OUTBOUND_VOICE_APPROVED=false
OUTBOUND_VOICE_GATEWAY_URL=
OUTBOUND_VOICE_GATEWAY_TOKEN=
OUTBOUND_ALLOWED_PREFIXES=
OUTBOUND_PROCESSOR_REGION=not_configured

# Native streamed speech and generated-tool proposals: disabled until supplier,
# clinic, pricing, and data-geography approval are verified for the specific site.
SPEECH_STREAMING_APPROVED=false
NATIVE_STREAMING_CALLS_APPROVED=false
STT_APPROVED_KEYTERMS_JSON=[]
DEEPGRAM_STREAM_TOKEN=
MODEL_STREAMING_APPROVED=false
MODEL_PROCESSOR_APPROVED=false
MODEL_RESPONSES_BASE=
MODEL_STREAM_TOKEN=
# Private Asterisk Manager observer; NOT the same key as MEDIA_API_TOKEN.
PBX_REQUIRE_STAFF_SCREENING=true
PBX_EVENT_TOKEN=
PBX_AMI_HOST=127.0.0.1
PBX_AMI_PORT=5038
PBX_AMI_TLS=false
PBX_AMI_USER=
PBX_AMI_SECRET=
