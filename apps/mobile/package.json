{
  "name": "hamava-reception-companion",
  "version": "0.2.2",
  "private": true,
  "description": "Hamava Android reception companion",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "build:debug": "cap sync android && node scripts/gradle.mjs assembleDebug",
    "build:release": "cap sync android && node scripts/gradle.mjs assembleRelease bundleRelease",
    "test": "node scripts/gradle.mjs testDebugUnitTest lintDebug",
    "capacitor:sync:after": "node scripts/harden-web.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
